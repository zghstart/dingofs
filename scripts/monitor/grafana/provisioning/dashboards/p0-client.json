{
  "uid": "dingofs-p0-client",
  "title": "DingoFS / Client",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "dingofs",
    "observability",
    "P0"
  ],
  "editable": true,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "DingoFS Prometheus",
          "value": "dingofs-prometheus"
        }
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(up, cluster)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(up{cluster=~\"$cluster\"}, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(up{cluster=~\"$cluster\"}, node)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "P0 source and interpretation",
      "options": {
        "mode": "markdown",
        "content": "**P0 / existing sources.** N/A means missing data or no traffic denominator. Scrape reachability is collection health. Quotas are per-instance snapshots. Cluster p99, business SLI and measured Data Flow require P1."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "id": 1
    },
    {
      "title": "Successful read and write operations",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "rate(dingofs_vfs_read_qps_total_count{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{instance}} read"
        },
        {
          "expr": "rate(dingofs_vfs_write_qps_total_count{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "B",
          "legendFormat": "{{instance}} write"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Successful read and write bytes",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "rate(dingofs_vfs_read_bps_total_count{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{instance}} read"
        },
        {
          "expr": "rate(dingofs_vfs_write_bps_total_count{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "B",
          "legendFormat": "{{instance}} write"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Successful read average latency",
      "type": "timeseries",
      "description": "Session/VFS user-space successful completions only; not the full application syscall.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "rate(dingofs_fuse_op_read_lat_total_value{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval]) / rate(dingofs_fuse_op_read_qps_total_count{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval]) / 1e6",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "All operation inflight",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "dingofs_fuse_op_all_inflight_num{cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Completion errors",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "rate(dingofs_fuse_op_all_error_num{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Read backpressure and write pressure counters",
      "type": "timeseries",
      "description": "Cumulative pressure events; no window gauges are passed to rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "rate(vfs_read_backpressure_num{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{instance}} read_backpressure"
        },
        {
          "expr": "rate(vfs_read_backpressure_timeout_num{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "B",
          "legendFormat": "{{instance}} read_backpressure_timeout"
        },
        {
          "expr": "rate(vfs_write_pressure_event_num{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "C",
          "legendFormat": "{{instance}} write_pressure_event"
        },
        {
          "expr": "rate(vfs_write_pressure_coalesced_event_num{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "D",
          "legendFormat": "{{instance}} write_pressure_coalesced_event"
        },
        {
          "expr": "rate(vfs_write_pressure_round_num{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "E",
          "legendFormat": "{{instance}} write_pressure_round"
        },
        {
          "expr": "rate(vfs_write_pressure_round_failure_num{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "F",
          "legendFormat": "{{instance}} write_pressure_round_failure"
        },
        {
          "expr": "rate(vfs_write_pressure_submit_failure_num{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "G",
          "legendFormat": "{{instance}} write_pressure_submit_failure"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Inflight Warmup Tasks",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "dingofs_vfs_inflight_warmup_tasks{cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Inflight Warmup Blocks",
      "type": "timeseries",
