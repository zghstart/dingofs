        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "dingofs_vfs_warmup_resolve_queued_tasks{cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
