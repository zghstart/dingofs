        }
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Warmup resolve latency",
      "type": "timeseries",
      "description": "Per-instance window mean, shown only with positive source QPS. Idle/low-volume windows are N/A.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "(dingofs_vfs_warmup_resolve_latency{cluster=~\"$cluster\",instance=~\"$instance\"} / 1e6) and on (cluster, instance) (dingofs_vfs_warmup_resolve_qps{cluster=~\"$cluster\",instance=~\"$instance\"} > 0)",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
