      },
      "targets": [
        {
          "expr": "dingofs_vfs_warmup_resolve_running_tasks{cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
