    {
      "title": "Warmup callback completion",
      "type": "timeseries",
      "description": "Callback success does not prove cached data is already readable.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "rate(dingofs_vfs_warmup_blocks_succeeded_total{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{instance}} callback OK/Exist"
        },
        {
          "expr": "rate(dingofs_vfs_warmup_blocks_failed_total{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "B",
          "legendFormat": "{{instance}} failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
