      "keepTime": true
    },
    {
      "title": "Cache",
      "type": "link",
      "url": "/d/dingofs-p0-cache",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Store",
      "type": "link",
      "url": "/d/dingofs-p0-store",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Capacity",
      "type": "link",
      "url": "/d/dingofs-p0-capacity",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Host",
      "type": "link",
