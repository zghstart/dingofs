{
  "uid": "dingofs-p0-store",
  "title": "DingoFS / Storage Backend",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "dingofs",
    "observability",
    "P0"
  ],
  "editable": true,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "DingoFS Prometheus",
          "value": "dingofs-prometheus"
        }
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(up, cluster)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(up{cluster=~\"$cluster\"}, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(up{cluster=~\"$cluster\"}, node)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "P0 source and interpretation",
      "options": {
        "mode": "markdown",
        "content": "**P0 / existing sources.** N/A means missing data or no traffic denominator. Scrape reachability is collection health. Quotas are per-instance snapshots. Cluster p99, business SLI and measured Data Flow require P1."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "id": 1
    },
    {
      "title": "Successful read and write bytes",
      "type": "timeseries",
      "description": "Requires OBS-05 fixed binary. Successful actual returned/accepted bytes, wrapper boundary, no inferred backend identity.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "rate(dingofs_block_read_block_bps_total_count{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{instance}} read"
        },
        {
          "expr": "rate(dingofs_block_write_block_bps_total_count{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "B",
          "legendFormat": "{{instance}} write"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Successful read and write requests",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "rate(dingofs_block_read_block_qps_total_count{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{instance}} read"
        },
        {
          "expr": "rate(dingofs_block_write_block_qps_total_count{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "B",
          "legendFormat": "{{instance}} write"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Read and write errors",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "rate(dingofs_block_read_block_eps_total_count{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{instance}} read"
        },
        {
          "expr": "rate(dingofs_block_write_block_eps_total_count{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "B",
          "legendFormat": "{{instance}} write"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Inflight PUTs",
      "type": "timeseries",
      "description": "Gauge: increment on start, decrement on completion. Never rate this value.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "block_put_async_num{cluster=~\"$cluster\",instance=~\"$instance\"} + block_put_sync_num{cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Inflight GETs",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "block_get_async_num{cluster=~\"$cluster\",instance=~\"$instance\"} + block_get_sync_num{cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Successful average read latency",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "rate(dingofs_block_read_block_lat_total_value{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval]) / rate(dingofs_block_read_block_qps_total_count{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval]) / 1e6",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      }
    }
  ],
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/dingofs-p0-overview",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Client",
      "type": "link",
      "url": "/d/dingofs-p0-client",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "MDS",
      "type": "link",
