{
  "uid": "dingofs-p0-cache",
  "title": "DingoFS / Cache",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "dingofs",
    "observability",
    "P0"
  ],
  "editable": true,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "DingoFS Prometheus",
          "value": "dingofs-prometheus"
        }
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(up, cluster)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(up{cluster=~\"$cluster\"}, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(up{cluster=~\"$cluster\"}, node)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "P0 source and interpretation",
      "options": {
        "mode": "markdown",
        "content": "**P0 / existing sources.** N/A means missing data or no traffic denominator. Scrape reachability is collection health. Quotas are per-instance snapshots. Cluster p99, business SLI and measured Data Flow require P1."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "id": 1
    },
    {
      "title": "Remote tier conditional hit ratio",
      "type": "timeseries",
      "description": "Same tier and time window. This is not the global origin miss ratio.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "rate(dingofs_remote_cache_hit_count{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval]) / (rate(dingofs_remote_cache_hit_count{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval]) + rate(dingofs_remote_cache_miss_count{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Disk used bytes",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "{__name__=~\"dingofs_disk_cache_[0-9]+_used_bytes\",cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Disk full flags",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "{__name__=~\"dingofs_disk_cache_[0-9]+_(stage|cache)_full\",cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Disk health states",
      "type": "timeseries",
      "description": "All fixed states are emitted as one-hot values. Missing or failed samples become unknown using disk identities retained for five minutes, then N/A.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "dingofs_cache_health_state{cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}} disk={{disk}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Disk running states",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "dingofs_cache_running_state{cluster=~\"$cluster\",instance=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "{{instance}} disk={{disk}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Remote tier bytes from one canonical alias",
      "type": "timeseries",
      "description": "remote_node_group compatibility alias is excluded to prevent double counting.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "rate(dingofs_remote_cache_cluster_range_total_bytes{cluster=~\"$cluster\",instance=~\"$instance\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      }
    }
  ],
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/dingofs-p0-overview",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Client",
      "type": "link",
      "url": "/d/dingofs-p0-client",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "MDS",
      "type": "link",
      "url": "/d/dingofs-p0-mds",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Cache",
      "type": "link",
      "url": "/d/dingofs-p0-cache",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Store",
      "type": "link",
      "url": "/d/dingofs-p0-store",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Capacity",
      "type": "link",
      "url": "/d/dingofs-p0-capacity",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Host",
      "type": "link",
      "url": "/d/dingofs-p0-host",
      "includeVars": true,
      "keepTime": true
    }
  ]
}
